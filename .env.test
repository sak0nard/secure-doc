# Test settings, loaded automatically by bun test. Local-only placeholder values, committed deliberately.

# App connects as the restricted role; migrations and seed use the owner role.
DATABASE_URL=postgres://secure_doc_app:app_local_only@localhost:5433/secure_doc_test
DATABASE_OWNER_URL=postgres://secure_doc_owner:owner_local_only@localhost:5433/secure_doc_test

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=secure-doc-test
S3_ACCESS_KEY_ID=rustfs_local
S3_SECRET_ACCESS_KEY=rustfs_local_secret
S3_REGION=ap-southeast-2

BASE_URL=http://localhost:3000
# Keys the one-time-code hashes. At least 32 characters.
OTP_PEPPER=local-only-pepper-change-me-0123456789
RETENTION_DAYS=2555
TRUST_PROXY=false
MOCK_OUTBOX_ENABLED=true
PORT=3000
